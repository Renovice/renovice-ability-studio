<Project Sdk="Microsoft.NET.Sdk">
  <!-- Composed-metadata reader for the update tool. Uses the metadata editor's own Packages.bin decoder; the Core
       project path comes from WORKSPACE.json (pass -p:MetadataEditorCore=<path to editor/Core/Core.csproj>). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MetadataEditorCore)" />
  </ItemGroup>
</Project>
