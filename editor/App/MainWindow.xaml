                                                      BorderBrush="{StaticResource Border}" HorizontalGridLinesBrush="#32343a"
                                                      ToolTip="Exact callsites keyed by prototype and bytecode instruction. Receiver type evidence and descriptor join basis show how strongly each API candidate is bound.">
