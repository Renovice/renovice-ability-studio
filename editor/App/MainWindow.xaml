                                                    <DataGridTextColumn Header="Proto" Binding="{Binding Prototype}" Width="50"/>
                                                    <DataGridTextColumn Header="Block" Binding="{Binding Block}" Width="50"/>
                                                    <DataGridTextColumn Header="Instr" Binding="{Binding Instruction}" Width="55"/>
                                                    <DataGridTextColumn Header="Expr" Binding="{Binding SourceOccurrence}" Width="46"/>
                                                    <DataGridTextColumn Header="Order" Binding="{Binding EffectOrder}" Width="50"/>
                                                    <DataGridTextColumn Header="Call" Binding="{Binding DisplayCall}" Width="190"/>
                                                    <DataGridTextColumn Header="Name hash" Binding="{Binding NameHash}" Width="92"/>
                                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110"/>
                                                    <DataGridTextColumn Header="Receiver" Binding="{Binding ReceiverDisplay}" Width="80"/>
                                                    <DataGridTextColumn Header="Receiver type" Binding="{Binding ReceiverTypeDisplay}" Width="150"/>
                                                    <DataGridTextColumn Header="Join basis" Binding="{Binding DescriptorJoin}" Width="170"/>
                                                    <DataGridTextColumn Header="Args" Binding="{Binding ArgumentDisplay}" Width="120"/>
                                                    <DataGridTextColumn Header="Results" Binding="{Binding ResultDisplay}" Width="100"/>
                                                    <DataGridTextColumn Header="Contract" Binding="{Binding ContractStatus}" Width="105"/>
                                                    <DataGridTextColumn Header="Confidence" Binding="{Binding ContractConfidence}" Width="130"/>
                                                    <DataGridTextColumn Header="Arity" Binding="{Binding Contract.Match}" Width="120"/>
                                                    <DataGridTextColumn Header="Descriptor" Binding="{Binding Contract.Descriptor}" Width="280"/>
                                                    <DataGridTextColumn Header="Parameters" Binding="{Binding Contract.Parameters}" Width="260"/>
                                                    <DataGridTextColumn Header="Returns" Binding="{Binding Contract.Returns}" Width="180"/>
                                                    <DataGridTextColumn Header="Evidence" Binding="{Binding Contract.Evidence}" Width="360"/>
                                                    <DataGridTextColumn Header="Readable line" Binding="{Binding ReadableSpan.Line}" Width="82"/>
                                                    <DataGridTextColumn Header="Fidelity line" Binding="{Binding FidelitySpan.Line}" Width="82"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>
