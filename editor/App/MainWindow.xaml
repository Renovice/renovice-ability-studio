                                                        <Button Content="Jump Target Source" Click="JumpOutlineRelationTarget_Click" Style="{StaticResource SecondaryButton}"/>
                                                    </StackPanel>
                                                    <DataGrid x:Name="PrototypeRelationsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#1c1d22" Foreground="{StaticResource Text}"
                                                              BorderBrush="{StaticResource Border}" HorizontalGridLinesBrush="#32343a">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130"/>
                                                            <DataGridTextColumn Header="From" Binding="{Binding From}" Width="105"/>
                                                            <DataGridTextColumn Header="To" Binding="{Binding To}" Width="65"/>
                                                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="190"/>
                                                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="135"/>
                                                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="360"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="CLOSURE OWNERSHIP">
                                        <Grid Margin="6">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <TextBlock x:Name="ClosureMapSummary" Text="No validated closure ownership map is loaded." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,0,2,7"/>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,7">
                                                <Button Content="Show Parent Identities" Click="ShowClosureParent_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                                                <Button Content="Show Target Identities" Click="ShowClosureTarget_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                                                <Button Content="Jump Target Source" Click="JumpClosureTarget_Click" Style="{StaticResource SecondaryButton}"/>
                                            </StackPanel>
                                            <DataGrid x:Name="ClosureRowsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                                      SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#1c1d22" Foreground="{StaticResource Text}"
                                                      BorderBrush="{StaticResource Border}" HorizontalGridLinesBrush="#32343a">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Parent" Binding="{Binding ParentPrototype}" Width="60"/>
                                                    <DataGridTextColumn Header="Instruction" Binding="{Binding Instruction}" Width="78"/>
                                                    <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="95"/>
                                                    <DataGridTextColumn Header="Dest R" Binding="{Binding DestinationRegister}" Width="60"/>
                                                    <DataGridTextColumn Header="Operand" Binding="{Binding OperandNamespace}" Width="70"/>
                                                    <DataGridTextColumn Header="Index" Binding="{Binding OperandIndex}" Width="55"/>
                                                    <DataGridTextColumn Header="Target" Binding="{Binding TargetPrototype}" Width="60"/>
                                                    <DataGridTextColumn Header="Params" Binding="{Binding TargetParameters}" Width="58"/>
                                                    <DataGridTextColumn Header="Upvalues" Binding="{Binding TargetUpvalues}" Width="65"/>
                                                    <DataGridTextColumn Header="Max stack" Binding="{Binding TargetMaxStack}" Width="70"/>
                                                    <DataGridTextColumn Header="Captures" Binding="{Binding Captures}" Width="420"/>
                                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="65"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="VERIFICATION">
                                        <Grid Margin="6">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <TextBlock x:Name="SemanticVerificationSummary" Text="No semantic verification document is loaded." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,0,2,7"/>
                                            <TextBlock x:Name="SemanticVerificationPathText" Grid.Row="1" Text="No semantic verification path." Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="2,0,2,7"/>
                                            <DataGrid x:Name="ExportRowsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                                      SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#1c1d22" Foreground="{StaticResource Text}"
                                                      BorderBrush="{StaticResource Border}" HorizontalGridLinesBrush="#32343a" MouseDoubleClick="ExportRowsGrid_MouseDoubleClick"
                                                      ToolTip="Exact root exports. Double-click to jump to the verified readable identifier span.">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Exact export" Binding="{Binding ExportedName}" Width="190"/>
                                                    <DataGridTextColumn Header="Readable identity" Binding="{Binding Readable}" Width="190"/>
                                                    <DataGridTextColumn Header="Proto" Binding="{Binding Prototype}" Width="55"/>
                                                    <DataGridTextColumn Header="Web" Binding="{Binding Web}" Width="55"/>
                                                    <DataGridTextColumn Header="Occurrences" Binding="{Binding SourceOccurrenceCount}" Width="80"/>
                                                    <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="260"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBox x:Name="SemanticVerificationEditor" Grid.Row="3" Margin="0,7,0,0" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" SpellCheck.IsEnabled="False"/>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                        <TabItem Header="DIAGNOSTICS">
                            <TextBox x:Name="DiagnosticsBox" Margin="10" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                        </TabItem>
                        <TabItem Header="BUILD MANIFEST">
                            <TextBox x:Name="ManifestBox" Margin="10" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
