                                                            <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding StockCaption}" Foreground="#77D09A" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding RecommendedCaption}" Foreground="#E7B967" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Explanation}" Foreground="#B9BAC1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,20,0"/>
                                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="17" VerticalContentAlignment="Center"/>
                                                            <Border Grid.Column="1" Background="#30323A" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="7">
                                                                <TextBlock Text="{Binding Unit}" HorizontalAlignment="Center" Foreground="#C8C9CE"/>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Grid Grid.Row="3" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Choose any Windows folder. The Studio keeps the editable project internally, runs every strict gate, then exports a verified Lua file or native metadata patch for the selected control." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
