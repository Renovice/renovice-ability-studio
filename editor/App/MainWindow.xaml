                                            <DataGrid x:Name="SemanticRowsGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                                      SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#1c1d22" Foreground="{StaticResource Text}"
                                                      BorderBrush="{StaticResource Border}" HorizontalGridLinesBrush="#32343a" SelectionChanged="SemanticRowsGrid_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Proto" Binding="{Binding Prototype}" Width="55"/>
