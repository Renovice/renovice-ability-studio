                                    <Button x:Name="ResetMissionValuesButton" Grid.Column="2" Content="Reset to Stock" Click="ResetMissionValues_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="3" Content="Build + Save Mission Edit" Click="CreateMissionTimerPatch_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="TARGET &amp; BEHAVIOR">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
