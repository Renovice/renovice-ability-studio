                                                              BorderBrush="{StaticResource Border}" HorizontalGridLinesBrush="#32343a">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Proto" Binding="{Binding Prototype}" Width="55"/>
                                                            <DataGridTextColumn Header="Evidence role" Binding="{Binding EvidenceRole}" Width="165"/>
                                                            <DataGridTextColumn Header="Exact exports" Binding="{Binding ExactExports}" Width="180"/>
                                                            <DataGridTextColumn Header="IDs" Binding="{Binding IdentityRows}" Width="48"/>
                                                            <DataGridTextColumn Header="Mapped" Binding="{Binding SourceMappedIdentities}" Width="58"/>
