                                                    <DataGridTextColumn Header="Member" Binding="{Binding Member}" Width="150"/>
                                                    <DataGridTextColumn Header="IDs" Binding="{Binding IdentityRows}" Width="48"/>
                                                    <DataGridTextColumn Header="Protos" Binding="{Binding PrototypeCount}" Width="52"/>
