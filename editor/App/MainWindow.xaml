                                                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Hunk" Binding="{Binding Index}" Width="50"/>
                                                            <DataGridTextColumn Header="Proto" Binding="{Binding Prototype}" Width="55"/>
                                                            <DataGridTextColumn Header="Base line" Binding="{Binding BaseStartLine}" Width="70"/>
                                                            <DataGridTextColumn Header="Base rows" Binding="{Binding BaseLineCount}" Width="68"/>
                                                            <DataGridTextColumn Header="User rows" Binding="{Binding UserLineCount}" Width="68"/>
                                                            <DataGridTextColumn Header="Generated line" Binding="{Binding GeneratedStartLine}" Width="92"/>
                                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
