                                    <TextBlock Text="EXACT TARGET &amp; AUTHORING CONTRACT" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><Label Content="Project ID"/><TextBox x:Name="ProjectIdBox"/></StackPanel>
                                        <StackPanel Grid.Column="2"><Label Content="Installed build"/><TextBox x:Name="InstalledBuildBox"/></StackPanel>
                                    </Grid>
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><Label Content="Warframe"/><TextBox x:Name="WarframeBox"/></StackPanel>
                                        <StackPanel Grid.Column="2"><Label Content="Ability"/><TextBox x:Name="AbilityBox"/></StackPanel>
                                    </Grid>
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><Label Content="Ability identifier"/><TextBox x:Name="AbilityIdBox"/></StackPanel>
                                        <StackPanel Grid.Column="2"><Label Content="Module body key"/><TextBox x:Name="BodyKeyBox" FontFamily="Consolas"/></StackPanel>
                                    </Grid>
                                    <Label Content="Native module path" Margin="0,9,0,0"/><TextBox x:Name="ModulePathBox"/>
                                    <Label Content="Effect summary" Margin="0,9,0,0"/><TextBox x:Name="EffectSummaryBox" TextWrapping="Wrap" AcceptsReturn="True" Height="52"/>
                                    <TextBlock x:Name="HelminthStatusText" Text="Helminth: select a catalog ability" Foreground="{StaticResource Muted}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="AddonFields" Margin="0,9,0,0">
                                        <Label Content="Proven hook binding"/><TextBox x:Name="HookBox"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <TabControl x:Name="BottomTabs" Background="Transparent" BorderThickness="0">
                        <TabItem Header="SOURCE WORKSPACE">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SourcePathText" Text="Addon source is generated after a successful build." Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SemanticStateText" Grid.Column="1" Text="NO PROVENANCE MAP" Foreground="#d5a85d" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
                                    <Button x:Name="BrowseSourceButton" Grid.Column="2" Content="Open Native Source…" Click="BrowseSource_Click" Style="{StaticResource SecondaryButton}" Margin="8,0" Visibility="Collapsed"/>
                                    <Button x:Name="RebaseSourceButton" Grid.Column="3" Content="Preview Structural Rebase" Click="RebaseSource_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Visibility="Collapsed"
                                            ToolTip="Render a fresh verified source, map user edits through hash-bound prototype anchors, and stop on every overlap or missing anchor."/>
                                    <Button x:Name="ApplyRebaseButton" Grid.Column="4" Content="Apply Verified Rebase" Click="ApplyRebase_Click" Background="#557744" Margin="0,0,8,0" Visibility="Collapsed" IsEnabled="False"
