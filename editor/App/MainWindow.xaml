                                    <Button Grid.Column="5" Content="Save Source" Click="SaveSource_Click" Style="{StaticResource SecondaryButton}"/>
                                </Grid>
                                <TabControl x:Name="SourceWorkspaceTabs" Grid.Row="1" Background="Transparent" BorderThickness="1">
                                    <TabItem Header="READABLE / EDITABLE">
                                        <Grid Margin="6">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Border Background="#18191e" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="7,5" Margin="0,0,0,6">
                                                <TextBlock x:Name="SourceCallDiagnosticsSummary"
                                                           Text="INLINE API EVIDENCE — no hash-validated callsite proof is loaded."
                                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                            </Border>
                                            <TextBox x:Name="SourceEditor" Grid.Row="1" FontFamily="Cascadia Mono, Consolas" FontSize="13" AcceptsReturn="True" AcceptsTab="True"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" SpellCheck.IsEnabled="False"
                                                     TextChanged="SourceEditor_TextChanged" MouseMove="SourceEditor_MouseMove" MouseLeave="SourceEditor_MouseLeave"/>
                                        </Grid>
                                    </TabItem>
                                    <TabItem x:Name="RebaseReviewTab" Header="REBASE REVIEW">
                                        <Grid Margin="6">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
                                            <Border Background="#18191e" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="7,5" Margin="0,0,0,6">
                                                <TextBlock x:Name="RebaseSummaryText" Text="No structural rebase preview is loaded." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                            </Border>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                    <TextBlock Text="ORIGINAL VERIFIED BASE" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="2,0,2,5"/>
                                                    <TextBox x:Name="RebaseBaseEditor" Grid.Row="1" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" AcceptsReturn="True"
                                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" SpellCheck.IsEnabled="False"/>
                                                </Grid>
                                                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                                                <Grid Grid.Column="2">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                    <TextBlock Text="FRESH GENERATED BASE" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="2,0,2,5"/>
                                                    <TextBox x:Name="RebaseGeneratedEditor" Grid.Row="1" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" AcceptsReturn="True"
                                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" SpellCheck.IsEnabled="False"/>
                                                </Grid>
                                                <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                                                <Grid Grid.Column="4">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                    <TextBlock Text="USER EDITED SOURCE" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="2,0,2,5"/>
                                                    <TextBox x:Name="RebaseUserEditor" Grid.Row="1" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" AcceptsReturn="True"
                                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" SpellCheck.IsEnabled="False"/>
                                                </Grid>
                                            </Grid>
                                            <TabControl Grid.Row="2" Margin="0,7,0,0" Background="Transparent" BorderThickness="1">
