<Window x:Class="Renovice.AbilityEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Renovice.AbilityEditor.Core;assembly=AbilityEditor.Core"
        Title="RENOVICE Ability Studio" Width="1720" Height="920" MinWidth="1120" MinHeight="720"
        Background="#18191d" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#222329"/>
        <SolidColorBrush x:Key="PanelRaised" Color="#2a2c33"/>
        <SolidColorBrush x:Key="Border" Color="#3b3d46"/>
        <SolidColorBrush x:Key="Text" Color="#e8e8ea"/>
        <SolidColorBrush x:Key="Muted" Color="#9a9ca6"/>
        <SolidColorBrush x:Key="Accent" Color="#c59b43"/>
        <SolidColorBrush x:Key="Blue" Color="#2679ad"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
        <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="0,0,0,4"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1c1d22"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="7,5"/><Setter Property="SelectionBrush" Value="#61512f"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1c1d22"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#565967"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/><Setter Property="MaxDropDownHeight" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="ComboRoot" SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                      HorizontalAlignment="Left" IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Border Grid.Column="1" Background="#272930" BorderBrush="#424550" BorderThickness="1,0,0,0" CornerRadius="0,3,3,0">
                                        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#D7B866"
                                              Data="M 0 0 L 5 5 L 10 0 Z"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#1C1D22" BorderBrush="#686B78" BorderThickness="1" CornerRadius="3"
                                        MinWidth="{Binding ActualWidth, ElementName=ComboRoot}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,2,0,0">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True" CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="#272930"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboRoot" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1C1D22"/><Setter Property="Foreground" Value="#E8E8EA"/>
            <Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A3426"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#806B38"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#5A4821"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemBorder" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Blue}"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,7"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#41434c"/>
        </Style>
        <Style x:Key="ModeToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#b7b8bf"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="24,13"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#30323a"/>
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeBorder" Property="Background" Value="#2d2f36"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#30323a"/><Setter Property="Foreground" Value="#d8d8dc"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1c1d22"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="RowBackground" Value="#222329"/>
            <Setter Property="AlternatingRowBackground" Value="#272930"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#32343a"/>
            <Setter Property="VerticalGridLinesBrush" Value="#32343a"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30323a"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#554724"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#32343a"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="#222329"/>
            <Setter Property="Padding" Value="13,7"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,2">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#30323a"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#2b2d34"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#202127" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="18,8,30,8">
                    <TextBlock Text="RENOVICE" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="ABILITY STUDIO" FontWeight="Bold" FontSize="18"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="AddonMode" Style="{StaticResource ModeToggle}" Content="ADDON" GroupName="Mode" Checked="Mode_Checked"/>
                    <RadioButton x:Name="ReplacementMode" Style="{StaticResource ModeToggle}" Content="REPLACEMENT" GroupName="Mode" Checked="Mode_Checked"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="22,0,0,0">
                    <Border x:Name="StateBadge" Background="#554724" CornerRadius="3" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock x:Name="StateText" Text="DRAFT" Foreground="#f2d58e" FontWeight="Bold" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <TextBlock x:Name="BuildIdentity" Text="No project loaded" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#202127" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatus" Text="Ready" Foreground="#9bc68d" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Save Project" Click="Save_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Validate" Click="Validate_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button x:Name="BuildButton" Content="Build Staged Package" Click="Build_Click" Margin="0,0,8,0"/>
                    <Button x:Name="OpenOutputButton" Content="Open Output" Click="OpenOutput_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="DeployButton" Content="Deploy…" Click="Deploy_Click" Background="#8a5a24" IsEnabled="False" Margin="0,0,8,0" ToolTip="Hash-verify the staged artifact, snapshot the previous target, then replace atomically."/>
                    <Button x:Name="RollbackButton" Content="Rollback" Click="Rollback_Click" Background="#7b3434" IsEnabled="False" ToolTip="Restore the exact pre-deployment file from the verified transaction snapshot."/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="ABILITIES">
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Top">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="AbilitySearchBox" ToolTip="Search Warframes, abilities, identifiers, or scripts" TextChanged="AbilitySearch_TextChanged"/>
                                    <Button Grid.Column="1" Content="Refresh" Click="RefreshCatalog_Click" Padding="8,5" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"/>
                                </Grid>
                                <Border Background="#1c1d22" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="7" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="CatalogSummary" Text="Catalog not loaded" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="Exact metadata ownership + stock-byte body keys" Foreground="#72747d" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button Content="Use Target for Addon" Click="UseCatalogAddon_Click" Margin="0,0,0,6"/>
                                <Button Content="Use Target for Replacement" Click="UseCatalogReplacement_Click" Style="{StaticResource SecondaryButton}"/>
                                <TextBlock Text="Unresolved entries remain visible but cannot be built until their exact stock body is present." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,0"/>
                            </StackPanel>
                            <TreeView x:Name="AbilityTree" Background="#1c1d22" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                      SelectedItemChanged="AbilityTree_SelectedItemChanged">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="2"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2b2d34"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3a5369"/><Setter Property="Foreground" Value="White"/></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type core:WarframeCatalogEntry}" ItemsSource="{Binding Abilities}">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"/>
                                    </HierarchicalDataTemplate>
                                    <DataTemplate DataType="{x:Type core:AbilityCatalogEntry}">
                                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding ModulePath}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"/>
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="PROJECTS">
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Top">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="PROJECTS" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ Addon" Click="NewAddon_Click" Padding="8,4" FontSize="11" Margin="5,0"/>
                                    <Button Grid.Column="2" Content="+ Replace" Click="NewReplacement_Click" Padding="8,4" FontSize="11"/>
                                </Grid>
                                <TextBox x:Name="SearchBox" ToolTip="Search projects" TextChanged="Search_TextChanged" Margin="0,0,0,8"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button Content="Open Project…" Click="OpenProject_Click" Style="{StaticResource SecondaryButton}"/>
                                <TextBlock Text="Examples are read-only templates. Saving creates a project under work/ability-projects." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                            <ListBox x:Name="ProjectList" Background="#1c1d22" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                     SelectionChanged="ProjectList_SelectionChanged" DisplayMemberPath="DisplayName"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="500"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <TabControl Background="Transparent" BorderThickness="0">
                        <TabItem Header="QUICK STATS">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
                                    <StackPanel Width="520"><TextBlock Text="CANONICAL LINKED STATS" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="One definition feeds gameplay and ordinary native ability-card rows." Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Add Stat" Click="AddStat_Click" Padding="10,5" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                                        <Button Content="Remove" Click="RemoveStat_Click" Padding="10,5" Style="{StaticResource SecondaryButton}"/>
                                    </StackPanel>
                                </StackPanel>
                                <DataGrid x:Name="StatsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                                          Background="#1c1d22" Foreground="{StaticResource Text}" RowBackground="#222329" AlternatingRowBackground="#272930"
                                          BorderBrush="{StaticResource Border}" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                          HorizontalScrollBarVisibility="Auto" CellEditEnding="StatsGrid_CellEditEnding" CurrentCellChanged="StatsGrid_CurrentCellChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                        <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="155"/>
                                        <DataGridComboBoxColumn x:Name="StatKindColumn" Header="Kind" SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" Width="88"/>
                                        <DataGridTextColumn Header="Base" Binding="{Binding Base, UpdateSourceTrigger=PropertyChanged}" Width="68"/>
                                        <DataGridTextColumn Header="Min" Binding="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" Width="62"/>
                                        <DataGridTextColumn Header="Max" Binding="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" Width="62"/>
                                        <DataGridComboBoxColumn x:Name="ModifierFamilyColumn" Header="Modifier" SelectedItemBinding="{Binding ModifierFamily, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                        <DataGridTextColumn Header="Evidence binding" Binding="{Binding ModifierBinding, UpdateSourceTrigger=PropertyChanged}" Width="185"/>
                                        <DataGridCheckBoxColumn Header="Card" Binding="{Binding ShowOnCard}" Width="48"/>
                                        <DataGridComboBoxColumn x:Name="StatUnitColumn" Header="Unit" SelectedItemBinding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <DataGridTextColumn Header="Order" Binding="{Binding Order, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Label Content="Colloquial ability description (numbers belong in rows)"/>
                                        <TextBox x:Name="DescriptionBox" Height="62" AcceptsReturn="True" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Label Content="Native-card preview" VerticalAlignment="Center"/>
                                            <TextBox x:Name="PreviewStrengthBox" Grid.Column="1" Text="100" TextChanged="PreviewStrength_TextChanged" ToolTip="Preview Power Strength percent" Margin="4,0"/>
                                            <CheckBox x:Name="PreviewBaseStatsCheck" Grid.Column="2" Content="Base stats" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Checked="PreviewMode_Changed" Unchecked="PreviewMode_Changed"/>
                                        </Grid>
                                        <TextBlock x:Name="StatPreviewText" Background="#1c1d22" Foreground="{StaticResource Text}" Padding="8,5" Height="62" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="STOCK VALUES">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ABILITY STATS · CARD + GAMEPLAY" Foreground="{StaticResource Accent}" FontWeight="Bold"/>
                                        <TextBlock x:Name="StockValuesSummary" Text="Select an ability to read its native card labels and base/rank inputs." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Discover" Click="DiscoverStockValues_Click" Style="{StaticResource SecondaryButton}" Margin="8,0"/>
                                    <Button Grid.Column="2" Content="Create Replacement" Click="CreateStockReplacement_Click"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="StockValuesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#222C35" BorderBrush="#3B4651" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,20,0">
                                                            <TextBlock Text="{Binding Label}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding OriginalDisplay}" FontSize="14" Foreground="#77D09A" Margin="0,6,0,0"/>
                                                            <TextBlock Text="{Binding Explanation}" ToolTip="{Binding Evidence}" Foreground="#B9BAC1" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Editable}" FontSize="22" Padding="10"/>
                                                            <TextBlock Text="{Binding Unit}" FontSize="14" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                                           Text="Each editable control changes its verified card and gameplay inputs together. Native mod scaling is retained. Unverified values stay read-only. Create a replacement, then Validate and Build."/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="MISSION TIMERS">
                            <Grid Margin="14">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#202A33" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="180"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="SECTION" Foreground="{StaticResource Accent}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="MissionSectionBox" Grid.Column="1" SelectionChanged="MissionSection_SelectionChanged" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="MissionPresetBox" Grid.Column="2" SelectionChanged="MissionPreset_SelectionChanged"/>
                                        <Border Grid.Column="3" Background="#18303E" BorderBrush="#2D617D" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="12,0,0,0">
