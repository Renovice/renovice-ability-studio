<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MetadataEditorCoreProject Condition="Exists('..\..\..\metadata-editor\editor\Core\Core.csproj')">..\..\..\metadata-editor\editor\Core\Core.csproj</MetadataEditorCoreProject>
    <MetadataEditorCoreProject Condition="'$(MetadataEditorCoreProject)' == '' and Exists('..\..\external\WarframeMetaDataEditor\editor\Core\Core.csproj')">..\..\external\WarframeMetaDataEditor\editor\Core\Core.csproj</MetadataEditorCoreProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(MetadataEditorCoreProject)' != ''">
    <ProjectReference Include="$(MetadataEditorCoreProject)" />
  </ItemGroup>
  <Target Name="RequireMetadataEditorCore" BeforeTargets="ResolveProjectReferences" Condition="'$(MetadataEditorCoreProject)' == ''">
    <Error Text="Metadata Editor Core is missing. Clone this repository with --recursive, or place the repository at repos/apps/metadata-editor in a RENOVICE workspace." />
  </Target>
</Project>
